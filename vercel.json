{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "true",
  "outputDirectory": "site",
  "redirects": [
    { "source": "/:modulo(arquitetura|grafos|aeds|ia)", "destination": "/:modulo/", "permanent": true }
  ],
  "rewrites": [{ "source": "/grafos/(.*)", "destination": "/grafos/index.html" }]
}
